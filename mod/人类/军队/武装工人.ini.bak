
[core]
name: 武装工人
class: CustomUnitMetadata
#overrideAndReplace:民兵
price: 170
maxHp: 100
mass: 150
unitsSpawnedOnDeath:zb5
unitsSpawnedOnDeath_setToTeamOfLastAttacker:true

tags: 民兵

techLevel: 1
buildSpeed: 0.003
radius: 10
displayRadius: 8

isBio: true
numBitsOnDeath:0
hideScorchMark:true
explodeOnDeath:false
effectOnDeath: NONE
explodeOnDeathGroundCollosion:false
effectOnDeathGroundCollosion: NONE


selfRegenRate:0.001
softCollisionOnAll: 12
canRepairBuildings:true
canRepairUnits:false
selfBuildRate:1
nanoRange:100
nanoFactorySpeed:0.5
exit_x:0
exit_y:-1

canBuild_1_name:民兵营
canBuild_1_pos:  1
canBuild_1_forceNano: true

canBuild_2_name:难民营
canBuild_2_pos:  2
canBuild_2_forceNano: true

canBuild_3_name:狙击塔
canBuild_3_pos:  3
canBuild_3_forceNano: true

canBuild_4_name:repairbay
canBuild_4_pos:  4
canBuild_4_forceNano: true

canBuild_5_name:熔炉
canBuild_5_pos:  5
canBuild_5_forceNano: true

canBuild_6_name:补给站
canBuild_6_pos:  6
canBuild_6_forceNano: true


effectOnDeath:CUSTOM:SW, CUSTOM:X*7

[effect_SW]
life: 0
fadeInTime: 0
fadeOut: false
alsoPlaySound: S1.ogg:0.5, S2.ogg:0.5, S3.ogg:0.5

[effect_X]
attachedToUnit: false
life: 60
physics: true
scaleFrom:0.03
scaleTo: 0.01
xSpeedRelativeRandom: 0.7
ySpeedRelativeRandom: 0.7
hSpeed: 1
image: X.png
drawUnderUnits:false

[graphics]
total_frames: 1
imageScale: 0.5
image:        武装工人.png
image_wreak: NONE
image_turret: NONE


lock_body_rotation_with_main_turret: true


image_shadow: AUTO
shadowOffsetX:1

shadowOffsetY:1

[attack]

isFixedFiring: true
canAttack: true
canAttackFlyingUnits: true
canAttackLandUnits:   true
canAttackUnderwaterUnits: false
turretSize: 10
turretTurnSpeed: 9
maxAttackRange: 170
shootDelay: 12

[turret_1]
x: 5
y: 5
shoot_sound:large_gun_fire1
shoot_sound_vol:0.5


[projectile_1]
directDamage: 20
life: 80
speed: 17

image: 炮弹1.png
drawSize: 0.35

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock

[effect_lightningShock]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:damage.png
total_frames: 12
animateFrameStart: 0
animateFrameEnd: 11
animateFramePingPong: false
animateFrameSpeed: 0.5

[movement]
movementType: LAND
moveSpeed:0.95
moveAccelerationSpeed: 0.17
moveDecelerationSpeed: 0.17
maxTurnSpeed: 9
turnAcceleration: 0.9
moveSlidingMode :true
moveIgnoringBody:true
moveSlidingDir:  181

[ai]
useAsBuilder:true
maxGlobal:1
maxEachBase:1