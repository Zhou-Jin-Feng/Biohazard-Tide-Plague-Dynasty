
[core]
name: jpc(瘫痪)
displayText: 吉普车(瘫痪)
displayDescription:能快速移动的载具，可搭载2人
class: CustomUnitMetadata
price: 900
maxHp: 1000
mass: 1200
maxShield:15
shieldRegen:1111
shieldDisplayOnlyDeflection:true
shieldRenderRadius:0
techLevel: 1
buildSpeed: 0.001
#availableInDemo: true
radius: 20
displayRadius: 30
isBio: false

#selfRegenRate:0.0009
#buildingSelectionOffset: 23
maxTransportingUnits: 2
transportUnitsRequireTag: 民兵
softCollisionOnAll: 12
transportUnitsKillOnDeath:false

[action_自动维护]
price:0
autoTrigger:if self.timeAlive(laterThanSeconds=8)
buildSpeed:7s
addResources:unsetFlag=5
#isVisible:if self.hasFlag(id=5)
#isActive:if self.hasFlag(id=5)
#canPlayerCancel:false
convertTo: jpc
isVisible:false
pos=1

[action_手动维护]
price:0
text:恢复动力
buildSpeed:3s
addResources:unsetFlag=5
isVisible:true
isActive:true
canPlayerCancel:false
convertTo: jpc
pos=2

[graphics]
imageScale: 0.5
total_frames: 1
image:        悍马.png
image_wreak:  悍马残骸.png
image_turret: 重机枪1.png
scaleImagesTo: 43
scaleTurretImagesTo: 15

#AUTO
image_shadow: AUTO
shadowOffsetX:1
shadowOffsetY:1


[attack]

canAttack: false
canAttackFlyingUnits: false
canAttackLandUnits:   false
canAttackUnderwaterUnits: false

isFixedFiring: false

turretSize: 20
turretTurnSpeed: 0

maxAttackRange: 210
shootDelay: 7

[turret_1]
x: 0
y: 0
shoot_sound:gun_fire
shoot_sound_vol:2
energyUsage: 0

[projectile_1]
directDamage: 45
life: 80
speed: 16
image: 炮弹1.png
drawSize: 0.35


[movement]
movementType: LAND
moveSpeed:0
moveAccelerationSpeed: 0.17
moveDecelerationSpeed: 0.07
maxTurnSpeed: 0
turnAcceleration: 0.5
