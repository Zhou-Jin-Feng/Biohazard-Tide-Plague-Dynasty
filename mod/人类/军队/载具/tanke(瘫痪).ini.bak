
[core]
name: tanke(瘫痪)
displayText: 坦克(瘫痪)
displayDescription:强大的战争机器，\n搭载士兵可解锁机枪
class: CustomUnitMetadata
price: 7500
maxHp: 5000
armour:30
armourMinDamageToKeep: 1
maxShield:45
shieldRegen:11111111
shieldRenderRadius:0
shieldDisplayOnlyDeflection:true
mass: 1880000
techLevel: 2
buildSpeed: 0.0004
#availableInDemo: true
experimental: true
radius: 35
#displayRadius: 23
isBio: false
softCollisionOnAll: 0

#buildingSelectionOffset: 23
maxTransportingUnits: 1
transportUnitsRequireTag: 民兵
transportUnitsKillOnDeath:false

[action_自动维护]
price:0
autoTrigger:if self.timeAlive(laterThanSeconds=10)
buildSpeed:7s
addResources:unsetFlag=5
#isVisible:if self.hasFlag(id=5)
#isActive:if self.hasFlag(id=5)
#canPlayerCancel:false
convertTo: tanke
isVisible:false
pos=1

[action_手动维护]
price:0
buildSpeed:3s
addResources:unsetFlag=5
isVisible:true
isActive:true
canPlayerCancel:false
convertTo: tanke
text:恢复动力
pos=2

[graphics]
total_frames: 1
imageScale: 0.5
image:        车盘3.png
image_wreak:  车盘3残骸.png
image_turret: p3.png

scaleImagesTo: 85
scaleTurretImagesTo: 35

image_shadow: AUTO
shadowOffsetX:1
shadowOffsetY:1

animation_moving_start: 0
animation_moving_end: 0
animation_moving_speed:8
animation_idle_start: 0
animation_idle_end: 0


[attack]
canAttack: true
canAttackFlyingUnits: true
canAttackLandUnits:   true
canAttackUnderwaterUnits: false

turretSize: 20
turretTurnSpeed: 0


maxAttackRange: 350
shootDelay: 170

[turret_1]
#forward turret
invisible: true
delay: 5
x: 1
y: 0
canAttackLandUnits: if self.transportingCount(greaterThan=0)
canAttackFlyingUnits: if self.transportingCount(greaterThan=0)
shoot_sound:gun_fire
shoot_sound_vol:0.5
projectile: 1


[turret_2]
#forward turret
x: 0
y: 0
warmup:5
size: 86
idleDir:0
shoot_sound:large_gun_fire2
shoot_sound_vol:2
shoot_flame:large
shoot_light:#FFEECCCC
projectile: 2

[projectile_1]
directDamage: 20
life: 80
speed: 16

image: 炮弹1.png
drawSize: 0.35


[projectile_2]
directDamage:1000
life: 500
speed:18
trailEffect: true
largeHitEffect: true
#frame: 11
areaDamage: 500
areaRadius: 75
image: 炮弹1.png
drawSize: 0.5

[movement]
movementType: LAND
moveSpeed:0
moveAccelerationSpeed: 0.07
moveDecelerationSpeed: 0.07
maxTurnSpeed: 0
turnAcceleration: 0.17

maxTurnSpeed: 0
turnAcceleration: 0.4

moveSlidingMode :false
moveIgnoringBody:false



[ai]

buildPriority:4


