//by蚟醛钯烨
[core]
name: 绿卵
displayDescription:生产僵尸的建筑\n作者:蚟醛钯烨\n(防傻逼盗mod专用水印)
class: CustomUnitMetadata
price: 1500
maxHp: 2000
mass: 9000
maxShield:5
shieldRegen:1111
shieldDisplayOnlyDeflection:true
techLevel: 1
generation_credits:5
generation_delay:40
buildSpeed: 0.0006
#availableInDemo: true
selfBuildRate:0.0006
selfRegenRate:0.001
tags:绿卵T1
footprint: -1,-1,1,1

constructionFootprint: -1,-1,1,3

canRepairBuildings:true
canRepairUnits:true
autoRepair:true
nanoRepairSpeed:0.5
nanoRange:125

radius: 18
#displayRadius: 25
isBio: true
isBuilding: true


softCollisionOnAll: 3
unitsSpawnedOnDeath:腐蚀性液体,zb4*3,尸坑

explodeOnDeath:true
effectOnDeath: CUSTOM:lightningShockD
explodeOnDeathGroundCollosion:true
effectOnDeathGroundCollosion: CUSTOM:lightningShockD


action_1_convertTo: 突变绿卵
action_1_price: 7000
action_1_text: 升级
action_1_displayType: upgrade
action_1_buildSpeed: 0.005
action_1_pos: 1
action_1_isLocked:if not numberOfUnitsInTeam(withTag='血肉祭坛', greaterThan=0) 
action_1_isLockedMessage:需要建造血肉祭坛



exit_x:0
exit_y:-1

canBuild_0_name: setRally,尸潮2
canBuild_0_pos:  0.1

canBuild_1_name:zb
canBuild_1_pos:  1


canBuild_4_name:pdzb,喷毒尸群,毒刺僵尸
canBuild_4_pos:  4


canBuild_6_name:zbzb
canBuild_6_pos:  6


[action_防御]
price:800,setFlag=3
text:防御
description:升级后能喷射毒液，反步兵
displayType: action
buildSpeed:2s
addResources:setFlag=3
isActive:if not self.hasFlag(id=3)
canPlayerCancel:false
pos=0

[graphics]
total_frames: 1

image:        clzb2.png
image_back:   NONE
image_wreak:  clzbdead.png

#scaleImagesTo: 20
#scaleTurretImagesTo: 9

#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_idle_start: 0
animation_idle_end: 0
animation_idle_speed: 80
animation_idle_scale_start:1
animation_idle_scale_end:1.1
animation_idle_pingPong: true


animation_attack_start: 0
animation_attack_end: 0
animation_attack_speed: 15
animation_attack_scale_start:1.2
animation_attack_scale_end:0.8
animation_attack_pingPong: true

[attack]
canAttack: true
canAttackFlyingUnits: true
canAttackLandUnits:   true
canAttackUnderwaterUnits: false

turretSize: 20
turretTurnSpeed: 2



maxAttackRange: 300
shootDelay: 100

[turret_1]
#
x: 0
y: -10
projectile: 1
turnSpeedAcceleration: 1.0
shoot_sound:cannon_firing
shoot_sound_vol:0.3
shoot_flame:small
shoot_light:#228B22

canAttackCondition:if self.hasFlag(id=3)

[turret_2]
#
x: 0
y: -10
attachedTo: 1

slave: true

invisible: true
copyFrom:1

[turret_3]
#
x: 0
y: -10
attachedTo: 1

slave: true

invisible: true
copyFrom:1



[projectile_1]
directDamage: 20
life: 150
speed: 4

image: 毒液.png
color: #008000
explodeOnEndOfLife:true
drawSize: 0.7
spawnUnit:小腐蚀性液体
areaDamage: 10
areaRadius: 60

targetGround: false

lightColor: #228B22
lightSize: 0.9

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock

[effect_lightningShock]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:感染特效.png
total_frames: 14
animateFrameStart: 0
animateFrameEnd: 13
animateFramePingPong: false
animateFrameSpeed: 0.5


[effect_lightningShockD]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:DUW.png
total_frames: 7
animateFrameStart: 0
animateFrameEnd: 6
animateFramePingPong: false
animateFrameSpeed: 0.25
scaleFrom: 0.6
scaleTo: 0.7

[movement]
movementType: NONE
moveSpeed: 0
moveAccelerationSpeed: 0.01
moveDecelerationSpeed: 0.01

maxTurnSpeed: 0
turnAcceleration: 0.1


[ai]
buildPriority:5
maxGlobal:3
maxEachBase:3