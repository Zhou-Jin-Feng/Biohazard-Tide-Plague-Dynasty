
[core]
name: tbd2
displayText: 血肉建筑师
displayDescription: 僵尸的基础建筑建造者，能遁地\n 作者:蚟醛钯烨\n(防傻逼盗mod专用水印)
class: CustomUnitMetadata
price: 3000
maxHp: 900
mass: 150

generation_credits:50
generation_delay:600
techLevel: 1
radius: 20
displayRadius: 8
buildSpeed: 0.01
nanoRepairSpeed:5
nanoRange:50
isBio:true
selfRegenRate:0.0005
unitsSpawnedOnDeath:sc2*4,尸块*3
softCollisionOnAll: 12

canRepairBuildings:true
canRepairUnits:false

selfBuildRate:0.9

exit_x:0
exit_y:-1

dieOnConstruct: true

canBuild_1_name:脑子
canBuild_1_pos:  1
canBuild_1_forceNano: true

canBuild_2_name:绿卵
canBuild_2_pos:  2
canBuild_2_forceNano: true

canBuild_3_name:虫坑
canBuild_3_pos:  3
canBuild_3_forceNano: true

canBuild_4_name:红卵
canBuild_4_pos:  4
canBuild_4_forceNano: true

canBuild_5_name:尸坑
canBuild_5_pos:  5
canBuild_5_forceNano: true

canBuild_6_name:血肉祭坛
canBuild_6_pos:  6
canBuild_6_forceNano: true

canBuild_8_name:王霸卵
canBuild_8_pos:  8
canBuild_8_forceNano: true

[graphics]
total_frames: 5
imageScale: 0.75
image:        尸虫.png
image_wreak: clzbdead.png
image_turret: NONE
scaleImagesTo: 50
#scaleTurretImagesTo: 9

#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_moving_start: 0
animation_moving_end: 0
animation_moving_speed: 25

animation_idle_start: 0
animation_idle_end: 0


animation_attack_start: 1
animation_attack_end: 4
animation_attack_speed: 10


[attack]

isMelee: true

canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: true

isFixedFiring: true

turretSize: 20
turretTurnSpeed: 3

maxAttackRange: 20
shootDelay: 30

[turret_1]
x: 0
y: 0
shoot_sound:firing3
shoot_sound_vol:2

[projectile_1]
directDamage: 120
life: 50
instant: true

[movement]
movementType: AIR
moveSpeed: 0.75
moveAccelerationSpeed: 0.02
moveDecelerationSpeed: 0.05

maxTurnSpeed: 1.0
turnAcceleration: 0.05

#moveSlidingMode :false
#moveIgnoringBody:false
#moveSlidingDir:  45


targetHeight: -8
targetHeightDrift: 0.4

maxTurnSpeed: 2.5
turnAcceleration: 0.1
landOnGround: true
#targetHeight:-1

[ai]
useAsBuilder:true

maxEachBase:2