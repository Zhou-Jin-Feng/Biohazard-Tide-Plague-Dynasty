
[core]
name: zb5
displayText: 僵尸
displayDescription: 普普通通的僵尸，由人类死亡后产生
class: CustomUnitMetadata
price: 5
maxHp: 150
mass: 50

techLevel: 1
nanoFactorySpeed:0.1
nanoRange:300


buildSpeed: 0.01
availableInDemo: false
radius: 10
displayRadius: 10
isBio: true
unitsSpawnedOnDeath:尸块
hideScorchMark:true
selfRegenRate:0.1



action_1_convertTo: 剥皮者
action_1_price: 100
action_1_text: 进化为剥皮者，\n近战，速度快，攻速快，血量不高
action_1_displayType: upgrade
action_1_buildSpeed: 0.04
action_1_pos: 0.01
action_1_isLocked:if not numberOfUnitsInTeam(withTag='血肉祭坛', greaterThan=0) 
action_1_isLockedMessage:需要建造血肉祭坛

softCollisionOnAll: 15

builtFrom_1_name: 红卵
builtFrom_1_pos:  6

builtFrom_2_name: 绿卵
builtFrom_2_pos:  66

builtFrom_3_name: 僵尸阵营
builtFrom_3_pos:  666

[action_Water]
autoTrigger:if self.isInWater()
isVisible:false
addResources:hp=-50

[action_Lava]
autoTrigger:if self.isOverLiquid() and not self.isOverwater()
isVisible:false
addResources:hp=-100

[graphics]
imageScale: 0.71
total_frames: 16

image:        z1.png
image_wreak: NONE
image_turret: NONE
#scaleImagesTo: 20
#scaleTurretImagesTo: 9

#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_moving_start: 0
animation_moving_end: 15
animation_moving_speed: 4

animation_idle_start: 4
animation_idle_end: 4


#animation_attack_start: 0
#animation_attack_end: 1
#animation_attack_speed: 5


[attack]

isMelee: true

canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: false

isFixedFiring: true

turretSize: 20
turretTurnSpeed: 3

maxAttackRange: 10
shootDelay: 30

[turret_1]
x: 0
y: 0
shoot_sound:A0.ogg
shoot_sound_vol:0.1

[projectile_1]
directDamage: 25
life: 50
instant: true

explodeEffect:NONE
explodeEffectOnShield:NONE


[movement]
movementType: LAND
moveSpeed: 1.0
moveAccelerationSpeed: 0.07
moveDecelerationSpeed: 0.12


maxTurnSpeed: 5.5
turnAcceleration: 0.5

moveSlidingMode :true
moveIgnoringBody:true
moveSlidingDir:  181
targetHeight:1

[ai]
buildPriority:10
ai_upgradePriority:1
maxEachBase:55