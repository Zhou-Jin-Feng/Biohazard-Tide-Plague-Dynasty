
[core]
name: 暗影行者(遁形)
displayDescription: 作者:蚟醛钯烨\n(防傻逼盗mod专用水印)
class: CustomUnitMetadata
price: 2000
maxHp: 500
mass: 250
armour:2
maxShield:200
shieldRegen:0.1
shieldDisplayOnlyDeflection:true
shieldRenderRadius:0
techLevel: 1
nanoFactorySpeed:0.3
nanoRange:300
experimental: true
buildSpeed: 0.0001
availableInDemo: false
canNotBeDirectlyAttacked:true
radius: 22
displayRadius: 18
isBio: false
selfRegenRate:0.01

softCollisionOnAll: 15

energyMax: 3
energyRegen: 0
energyNeedsToRechargeToFull: true

[action_trigger_HP]
autoTrigger: if self.energy(lessThan=2)
convertTo: 暗影行者
buildSpeed: 0
text: TRIGGER
isVisible: false

[action_Water]
autoTrigger:if self.isInWater()
isVisible:false
addResources:hp=-50

[action_Lava]
autoTrigger:if self.isOverLiquid() and not self.isOverwater()
isVisible:false
addResources:hp=-100

[graphics]
total_frames: 4
imageScale: 0.5
image:        紫爬.png
image_wreak: 亚空间阴影.png
image_turret: 亚空间阴影.png
scaleImagesTo: 50
scaleTurretImagesTo: 170

#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_moving_start: 0
animation_moving_end: 1
animation_moving_speed: 10

animation_idle_start: 0
animation_idle_end: 0


animation_attack_start: 0
animation_attack_end: 1
animation_attack_speed: 5


[attack]

isMelee: true

#dieOnAttack: true

canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: true

isFixedFiring: true

turretSize: 20
turretTurnSpeed: 3

maxAttackRange: 120
shootDelay: 10

[turret_1]
x: 0
y: 0
shoot_sound:firing3
shoot_sound_vol:2
shoot_flame:shockwave
resourceUsage:energy: 2

[projectile_1]
directDamage: 500
life: 50
instant: true
teleportSource:true

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock

[effect_lightningShock]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:亚空间攻击.png
total_frames: 12
animateFrameStart: 0
animateFrameEnd: 11
animateFramePingPong: false
animateFrameSpeed: 0.5


[movement]
movementType: OVER_CLIFF
moveSpeed: 1.5
moveAccelerationSpeed: 0.04
moveDecelerationSpeed: 0.12


maxTurnSpeed: 8.5
turnAcceleration: 2.6
targetHeight:-2

moveSlidingMode :false
moveIgnoringBody:true
moveSlidingDir:  181

reverseSpeedPercentage:0

