#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_moving_start: 0
animation_moving_end: 3
animation_moving_speed: 10

animation_idle_start: 0
animation_idle_end: 1


animation_attack_start: 3
animation_attack_end: 5
