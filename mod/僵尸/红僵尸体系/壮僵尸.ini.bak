canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: false

isFixedFiring: true

turretSize: 20
turretTurnSpeed: 3

maxAttackRange: 15
shootDelay: 45

[turret_1]
x: 0
y: 0
shoot_sound:A1.ogg
shoot_sound_vol:0.1
recoilOffset: 40
recoilOutTime: 6
recoilReturnTime: 60

[projectile_1]
