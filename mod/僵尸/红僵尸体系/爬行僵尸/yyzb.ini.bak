//by蚟醛钯烨
[core]
name: yyzb
displayText: 爬行者
displayDescription:近战，移速快，攻速快，伤害高，血量一般
class: CustomUnitMetadata
price: 2000
maxHp: 710
mass: 500
unitsSpawnedOnDeath:爬行者2,尸块
armour:10
maxShield:5
shieldRegen:111111
shieldDisplayOnlyDeflection:true
shieldRenderRadius:0
techLevel: 1
nanoFactorySpeed:0.1
generation_credits:50
generation_delay:300
buildSpeed: 0.009
availableInDemo: false

radius: 22
displayRadius: 18
isBio: true
selfRegenRate:0.6

softCollisionOnAll: 15


action_1_convertTo: 掠食者
action_1_price: 8000
action_1_text: 进化为掠食者，\n近战，血量厚，范围伤害。
action_1_displayType: upgrade
action_1_buildSpeed: 0.0006
action_1_pos: 0.01
action_1_isLocked:if not numberOfUnitsInTeam(withTag='红卵T2', greaterThan=0) 
action_1_isLockedMessage:需要建造红巨卵

[graphics]
imageScale: 0.5
total_frames: 4
image:        yyzb.png
image_wreak:  肉块.png
image_turret: NONE
#scaleImagesTo: 15
#scaleTurretImagesTo: 9

#AUTO
image_shadow: NONE
shadowOffsetX:1
shadowOffsetY:1


animation_moving_start: 0
animation_moving_end: 3
animation_moving_speed: 10

animation_idle_start: 1
animation_idle_end: 1


animation_attack_start: 2
animation_attack_end: 3
animation_attack_speed: 5


[attack]

isMelee: true

canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: false

isFixedFiring: true

turretSize: 20
turretTurnSpeed: 3

maxAttackRange: 30
shootDelay: 30

[turret_1]
x: 0
y: 0
shoot_sound:Z1.ogg
shoot_sound_vol:1

[projectile_1]
directDamage: 250
life: 50
instant: true

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock

[effect_lightningShock]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:damage.png
total_frames: 12
animateFrameStart: 0
animateFrameEnd: 11
animateFramePingPong: false
animateFrameSpeed: 0.5

[movement]
movementType: OVER_CLIFF
moveSpeed: 2.15
moveAccelerationSpeed: 0.2
moveDecelerationSpeed: 0.3
maxTurnSpeed: 3.8
turnAcceleration: 3.8




[ai]
buildPriority:4
ai_upgradePriority:1
maxEachBase:55