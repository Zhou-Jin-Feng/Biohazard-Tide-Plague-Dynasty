
[core]
name: 绿爬
class: CustomUnitMetadata
price: 3000
maxHp: 500
mass: 250
armour:2
maxShield:200
shieldRegen:1
shieldRenderRadius:0
shieldDisplayOnlyDeflection:true
#shieldDisplayOnlyDeflection:true
techLevel: 1
unitsSpawnedOnDeath:小腐蚀性液体,尸块
buildSpeed: 0.01
radius: 20
displayRadius: 20
experimental: true
isBio: true
#unitsSpawnedOnDeath:尸块
hideScorchMark:true
selfRegenRate:0.005
softCollisionOnAll: 12
canRepairBuildings:false
canRepairUnits:false
selfBuildRate:1
nanoRange:100
nanoFactorySpeed:0.2

energyMax: 10
energyRegen: 0.2
selfRegenRate:0.1

exit_x:0
exit_y:-1

fireTurretXAtSelfOnDeath:D

explodeOnDeath:true
effectOnDeath: CUSTOM:lightningShock


explodeOnDeathGroundCollosion:true
effectOnDeathGroundCollosion: CUSTOM:lightningShock

[action_留毒]
isVisible: true
isLocked:true
autoTrigger:if self.isMoving() and not self.isInWater()
pos: 0.3
buildSpeed: 0s
fireTurretXAtGround: ny
fireTurretXAtGround_withOffset:0,-5
text: 留毒
description: -陆地上移动时留下一小层毒液
displayType: infoOnly

[graphics]
imageScale: 0.5
total_frames: 5
image:        绿爬.png
image_wreak: NONE
image_turret: NONE
scaleImagesTo: 50


image_shadow: NONE
shadowOffsetX:1

shadowOffsetY:1

animation_moving_start: 1
animation_moving_end: 2
animation_moving_speed: 10

animation_idle_start: 0
animation_idle_end: 0
animation_idle_scale_end:1.07
animation_idle_pingPong: true

animation_attack_start: 3
animation_attack_end: 4
animation_attack_speed: 5
animation_attack_scale_end:0.97
animation_attack_pingPong: true



[attack]
canAttack: true
canAttackFlyingUnits: true
canAttackLandUnits:   true
canAttackUnderwaterUnits: true
isFixedFiring: true

turretSize: 20
turretTurnSpeed: 2



maxAttackRange: 230
shootDelay: 35

[turret_ny]
x: 0
y: 0
size:0
delay: 2.5
canShoot:false
invisible: true
projectile: ny
turnSpeed: 40

[projectile_ny]
#stomp
life: 10
instant: true
#drawSize: 0
targetGround:true
explodeEffectNONE
deflectionPower: -1
areaDamage: 0
areaRadius: 0
spawnUnit:极小腐蚀性液体
explodeEffect:NONE
explodeEffectOnShield:NONE
[turret_D]
#
x: 0
y: -10
canShoot: false
projectile: D
shoot_sound:P2.ogg
shoot_sound_vol:0.2


[turret_1]
#
x: 0
y: 10
canShoot: false
projectile: 2

#turnSpeedAcceleration: 1.0
shoot_sound:P2.ogg
shoot_sound_vol:0.2
#canShoot: true

[turret_2]
#
x: 0
y: 10
attachedTo: 1
slave: true
invisible: true
projectile: 2
#turnSpeedAcceleration: 1.0
#canShoot: true

[turret_3]
x: 0
y: 10
attachedTo: 1
slave: true
invisible: true
#energyUsage: 2
#shoot_flame: smoke
projectile:2


[turret_4]
x: 0
y: 0
attachedTo: 1
slave: true
invisible: true
#energyUsage: 2
#shoot_flame: smoke
projectile:1

[projectile_D]
directDamage: 0
life: 150
instant: true
spawnUnit:小腐蚀性液体
#targetGround:true
#targetGroundSpread: 10
areaDamage: 75
areaRadius: 100
areaHitAirAndLandAtSameTime: true
areaHitUnderwaterAlways:true

lightColor: #228B22
lightSize: 1.1

explodeEffect:CUSTOM:lightningShockD
explodeEffectOnShield:CUSTOM:lightningShockD

[projectile_1]
directDamage: 87
life: 150
speed: 4

image: 毒刺.png
color: #008000

drawSize: 0.4
spawnUnit:极小腐蚀性液体
targetGround:true
targetGroundSpread: 1
areaDamage: 75
areaRadius: 30
areaHitAirAndLandAtSameTime: true
areaHitUnderwaterAlways:true

lightColor: #228B22
lightSize: 1.1

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock



[projectile_2]
directDamage: 10
life: 9999
speed: 4

image: 毒液.png

drawSize: 0.4
color: #00FF00

spawnUnit:极小腐蚀性液体(淡)
targetGround:true
areaDamage: 30
areaRadius: 25
areaHitAirAndLandAtSameTime: true
areaHitUnderwaterAlways:true

lightColor: #3CB371
lightSize: 0.6

explodeEffect:CUSTOM:lightningShock
explodeEffectOnShield:CUSTOM:lightningShock

[effect_lightningShock]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:感染特效.png
total_frames: 14
animateFrameStart: 0
animateFrameEnd: 13
animateFramePingPong: false
animateFrameSpeed: 0.5

[effect_lightningShockD]
life: 60


hOffset: 0
dirOffset: 0

fadeInTime: 0
fadeOut: false

attachedToUnit: true


image:感染特效.png
total_frames: 14
animateFrameStart: 0
animateFrameEnd: 13
animateFramePingPong: false
animateFrameSpeed: 0.5
scaleFrom: 0.7
scaleTo: 0.7

[movement]
movementType: OVER_CLIFF_WATER
moveSpeed: 1.7
moveAccelerationSpeed: 0.3
moveDecelerationSpeed: 0.3

maxTurnSpeed: 1.0
turnAcceleration: 0.05

#moveSlidingMode :false
#moveIgnoringBody:false
#moveSlidingDir:  45


targetHeight: 5
