
[core]
name: 极小腐蚀性液体(淡)
displayDescription: 作者:蚟醛钯烨\n(防傻逼盗mod专用水印)
class: CustomUnitMetadata
price: 20
maxHp: 1000
mass: 100

techLevel: 1
buildSpeed: 0.005
#availableInDemo: true

armour: 999999999
armourMinDamageToKeep: 0
radius: 1
isBio: false
isBug: false
disableAllUnitCollisions:true
canNotBeDirectlyAttacked:true
isUnselectable:true
hideScorchMark:true

#numBitsOnDeath: 10

explodeOnDeath:false
effectOnDeath: NONE
explodeOnDeathGroundCollosion:false
effectOnDeathGroundCollosion: NONE

softCollisionOnAll: 80

[action_淡化]
autoTrigger:if self.timeAlive(laterThanSeconds=1)
addResources=hp=-999999
isVisible:false
pos=1


[graphics]
#imageScale: 0.5
total_frames: 1
image:        null.png
image_wreak:  NONE
image_turret: 05.png
scaleImagesTo: 30
scaleTurretImagesTo: 35

teamColorsUseHue:false
teamColorsOnTurret:false

#AUTO
image_shadow: AUTO
shadowOffsetX:0
shadowOffsetY:0



[attack]
canAttack: true
canAttackFlyingUnits: false
canAttackLandUnits:   true
canAttackUnderwaterUnits: true

turretSize: 0
turretTurnSpeed: 20


maxAttackRange: 16
shootDelay: 3

[turret_1]

x: 0
y: 0
canShoot: false
#invisible: true
turnSpeed:0

[turret_2]

x: 0
y: 0
projectile:1
shoot_sound:FS.ogg
shoot_sound_vol:0.25
invisible: true

[projectile_1]
areaDamage: 1
areaRadius: 16
targetGround:true
explodeOnEndOfLife:true
image:05.png
life: 0
speed: 0
areaHitUnderwaterAlways:true

explodeEffect:NONE
explodeEffectOnShield:NONE

[movement]
movementType: NONE
moveSpeed: 0
moveAccelerationSpeed: 0.07
moveDecelerationSpeed: 0.12
joinsGroupFormations: false
targetHeight:-1

maxTurnSpeed: 0
turnAcceleration: 0.4

reverseSpeedPercentage:0



